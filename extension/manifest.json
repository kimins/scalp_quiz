{
  "manifest_version": 3,
  "name": "Scalp Quiz Lookup",
  "version": "0.2.2",
  "description": "Show local stock and next-day return matches on scalp quiz cards.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a754f145-ea07-4a8f-a046-ce76d31fce71}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://scalping.kro.kr/quiz*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://scalping.kro.kr/quiz*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["quiz-core.mjs", "lookup.mjs", "db/manifest.json", "db/stocks-*.json", "db/w3-*.bin"],
      "matches": ["https://scalping.kro.kr/*"]
    }
  ]
}
